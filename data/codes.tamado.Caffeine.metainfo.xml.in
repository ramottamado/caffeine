<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>codes.tamado.Caffeine</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Caffeine</name>
  <summary>Keep your computer awake</summary>
  <description>
    <p>
      Caffeine stops your computer from suspending while its window is open.
      Close the window and your normal power settings apply again.
    </p>
  </description>

  <developer id="codes.tamado">
    <name>Tamado Sitohang</name>
  </developer>

  <!-- Required: Should be a link to the upstream homepage for the component -->
  <url type="homepage">https://tamado.codes/</url>

  <translation type="gettext">caffeine</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop
  file. -->
  <launchable type="desktop-id">codes.tamado.Caffeine.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and
  make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#e8d5c4</color>
    <color type="primary" scheme_preference="dark">#5e3c22</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/ramottamado/caffeine/main/data/screenshots/caffeine-00.png</image>
      <caption>Main window</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.0" date="2026-05-28">
      <description translate="no">
        <p>First release.</p>
      </description>
    </release>
  </releases>

</component>