#: data/codes.tamado.Caffeine.metainfo.xml.in:8
msgid "Keep your computer awake"
msgstr "Buat komputer Anda tetap terjaga"

#: data/codes.tamado.Caffeine.metainfo.xml.in:10
msgid ""
"Caffeine stops your computer from suspending while its window is open. Close "
"the window and your normal power settings apply again."
msgstr ""
"Caffeine mencegah komputer Anda masuk ke mode tidur selama jendelanya "
"terbuka. Tutup jendelanya dan pengaturan daya normal Anda akan berlaku "
"kembali."

